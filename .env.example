# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8787

# Comma-separated list of allowed origins (no trailing slash)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Supabase (Project Settings → API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to verify login tokens (Supabase → Project Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=
# Postgres connection string, transaction pooler (Supabase → Project Settings → Database). Secret.
DATABASE_URL=

# Cloudflare R2 for images (Cloudflare dashboard → R2). Secrets: server only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket (custom domain or the r2.dev URL), used to build image links.
R2_PUBLIC_URL=

# Chargily Pay (card payments). Test keys first. PUBLIC_API_URL = where Chargily can reach this API (webhook).
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test
PUBLIC_API_URL=

# Delivery company: Yalidine keys + the wilaya parcels leave from (French name, e.g. Alger).
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
DELIVERY_FROM_WILAYA=

# Protects /cron/* (Vercel sends it automatically). Use a long random value.
CRON_SECRET=

# One-way fingerprints of buyers' phone numbers and connections (repeat buyers / refused parcels, without keeping the number).
# Long random value (32+ characters). Set it ONCE and never change it.
FINGERPRINT_SECRET=
# Shared with store-web (same value there): lets the storefront forward the visitor's IP address.
STOREFRONT_SECRET=
