# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=8787

# Comma-separated list of allowed origins (no trailing slash)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Supabase (Project Settings → API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
